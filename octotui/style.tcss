
/* GitDiffViewer CSS - GitKraken-like Design */

Screen {
    background: transparent;
    color: $text;
}

OctotuiLogo {
    height: auto;
    max-height: 4;
    width: 100%;
    content-align: center middle;
}

.panel-header, #diff-header {
    text-align: center;
    padding: 0 1;
    background: transparent;
    color: $text;
    text-style: bold;
    border-bottom: solid #6c7086;
    max-height: 2;
}

GitDiffHistoryTabs {
    height: 1fr;
    width: 100%;
}

/* Status bar at the bottom */
#status-bar {
    dock: bottom;
    height: 1;
    width: 100%;
    background: $surface;
    color: $text;
    content-align: center middle;
    text-align: center;
}

/* Focused button styling for Tab navigation */
.button-focused {
    background: #bb9af7;
    color: #1a1b26;
    text-style: bold;
}

#diff-content {
    height: 1fr;
    overflow-y: auto;
}

.diff-markdown {
    padding: 0;
    background: transparent;
    border: none;
}

#history-content {
    height: 1fr;
    overflow-y: auto;
}



.commit-input {
    width: 100%;
    height: 6;
    border: solid #6c7086;
    background: transparent;
    padding: 0 1;
}

.commit-button {
    width: 100%;
    margin-top: 1;
    background: #9ece6a;
    color: black;
    text-style: bold;
}

.commit-button:hover {
    background: #9ece6a 60%;
}

.commit-button:disabled {
    background: transparent;
    color: $text-disabled;
}

/* GAC Configuration Modal Styles */
.gac-label {
    margin: 1 0 0 0;
    color: #bb9af7;
    text-style: bold;
}

.gac-input {
    margin: 1 0;
    width: 100%;
    border: solid #6c7086;
    background: transparent;
    color: white;
    padding: 0 1;
}

.gac-select {
    margin: 1 0;
    width: 100%;
    border: solid #6c7086;
}

.gac-buttons {
    align: center bottom;
    height: auto;
    margin: 2 0 0 0;
}

.test-button {
    background: #ff6b35;
    color: white;
    margin: 0 1;
    text-style: bold;
}

.test-button:hover {
    background: #ff8c5a;
}

.save-button {
    background: #bb9af7;
    color: white;
    margin: 0 1;
    text-style: bold;
}

.save-button:hover {
    background: #9bb8ff;
}

.cancel-button {
    background: #666666;
    color: white;
    margin: 0 1;
    text-style: bold;
}

.cancel-button:hover {
    background: #888888;
}

/* Action buttons row */
.button-row {
    width: 100%;
    height: auto;
    margin: 1 0;
    align: left middle;
}

.action-button {
    margin: 0 1 0 0;
    min-width: 24;
}

/* GAC loading indicator */
.gac-loading {
    width: auto;
    height: auto;
    margin: 0 0 0 1;
    display: none;
}

/* Commit Section Styles - Now in center panel tab */
.commit-label {
    margin: 0 0 0 0;
    color: #bb9af7;
    text-style: bold;
    height: 1;
}

.commit-input {
    margin: 0 0 1 0;
    border: solid #6c7086;
    background: transparent;
    color: white;
    height: 6;
}

.commit-body {
    margin: 0 0 1 0;
    border: solid #6c7086;
    background: transparent;
    color: white;
    height: 20;
    min-height: 15;
    width: 100%;
    padding: 1;
}

.commit-button {
    background: #9ece6a;
    color: #1a1b26;
    text-style: bold;
    min-width: 16;
    width: auto;
}

.commit-button:hover {
    background: #b4d88a;
}

.commit-section {
    padding: 2;
    height: 1fr;
    layout: vertical;
    overflow-y: auto;
}

/* Status tab styling */
.status-row {
    height: auto;
    width: 100%;
    margin: 0 0 1 0;
}

.status-label {
    width: 10;
    color: #6c7086;
}

.status-value {
    width: 1fr;
}

/* Hunk styling */
.hunk-container {
    layout: vertical;
    width: 100%;
    border: none;
    margin: 0;
    height: auto;
}

.hunk-header {
    background: transparent;
    color: $text;
    text-style: bold;
    padding: 0;
}

/* Tab styling */
TabbedContent {
    height: 1fr;
}

TabPane > Static {
    background: transparent;
    color: $text;
    text-style: bold;
}

TabbedContent > TabPane {
    background: transparent;
}

.added {
    background: #9ece6a 60%;
    color: black;
    width: 100%;
    padding: 0 1;
    height: auto;
}

.removed {
    background: #d3869b 60%;
    color: white;
    width: 100%;
    padding: 0 1;
    height: auto;
}

.unchanged {
    background: transparent;
    width: 100%;
    padding: 0 1;
    height: auto;
}

.hunk-buttons {
    width: 100%;
    height: auto;
    align: center middle;
    padding: 1 0;
}

.stage-button, .unstage-button {
    width: 12;
    margin: 0 1;
    height: auto;
    border: solid #6c7086;
    background: transparent;
    color: $text;
    text-style: bold;
}

.stage-button:hover, .unstage-button:hover {
    background: #9ece6a 60%;
}

.discard-button {
    width: 12;
    margin: 0 1;
    height: auto;
    border: solid #6c7086;
    background: transparent;
    color: $text;
    text-style: bold;
}

.discard-button:hover {
    background: #d3869b 60%;
}

.error {
    background: red;
    color: white;
    text-style: bold;
    width: 100%;
    padding: 0 1;
}

.info {
    background: transparent;
    color: $text;
    width: 100%;
    padding: 0 1;
}

Tabs {
    background: transparent;
}

Tabs > Tab {
    color: $text;
    background: transparent;
    text-style: bold;
}

Tabs > Tab.--active {
    background: transparent;
    border-bottom: solid #6c7086;
}

Tabs > Tab:hover {
    background: #9399b2;
}

/* Git status colors in tree */
Tree > .modified {
    color: #a9a1e1;
    text-style: bold;
}

Tree > .staged {
    color: #9ece6a;
    text-style: bold;
}

Tree > .untracked {
    color: #a9a1e1;
    text-style: bold;
}

Tree > .unchanged {
    color: $text;
}

Tree > .directory {
    color: #bb9af7;
    text-style: bold;
}

Tree > .tree--node {
    padding: 0 1;
    background: transparent;
}

/* File Tree tab */
#tree-content {
    width: 100%;
    height: 1fr;
}

#file-tree {
    width: 100%;
    height: auto;
    min-height: 10;
    background: transparent;
    padding: 1;
}

#file-tree > .tree--guides {
    color: #6c7086;
}

#file-tree > .tree--cursor {
    background: #313244;
}

/* Settings tab */
.settings-section {
    padding: 2;
    width: 100%;
}

.settings-title {
    text-style: bold;
    color: #bb9af7;
    padding: 1 0;
}

.settings-label {
    color: $text;
    padding: 1 0 0 0;
}

.settings-input {
    width: 50%;
    margin: 0 0 1 0;
}

.settings-hint {
    color: #6c7086;
    text-style: italic;
}

.settings-select {
    width: 50%;
    margin: 0 0 1 0;
}

.save-button {
    margin: 2 0 0 0;
    background: #9ece6a;
    color: #1a1b26;
}
